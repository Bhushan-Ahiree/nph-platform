# Copy this file to .env and fill in real values. Never commit .env.
ENVIRONMENT=development

# Database / queue (defaults point at the docker-compose services)
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
REDIS_URL=redis://redis:6379/0
API_PORT=8000

# Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local accounts created by scripts/seed_users.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
SCRAPER_BOT_EMAIL=bot.scraper@example.com
SCRAPER_BOT_PASSWORD=change-me

# LLM enrichment. false = deterministic parser only (no GPU / model download needed).
# To enable: set true, start with `docker compose --profile llm up`, then
# `docker compose exec ollama ollama pull llama3.2` and use OLLAMA_BASE_URL=http://ollama:11434
LLM_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# WhatsApp Cloud API (use mock_ prefixed tokens for local development)
ADMIN_PHONE=919000000000
META_VERIFY_TOKEN=mock_verify_token
# App secret used to verify X-Hub-Signature-256 on incoming webhooks (required; unsigned calls get 403)
META_APP_SECRET=mock_app_secret
WHATSAPP_PHONE_NUMBER_ID=mock_phone_number_id
WHATSAPP_ACCESS_TOKEN=mock_access_token
WHATSAPP_API_VERSION=v20.0
