# Copy this file to .env and fill in real values. Never commit .env.
ENVIRONMENT=development

# Database / queue
MONGO_URI=mongodb://localhost:27017/nph_core
REDIS_URL=redis://redis:6379/0
API_PORT=8000

# Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Scraper service account (register this user via /auth/register first)
SCRAPER_BOT_EMAIL=bot.scraper@example.com
SCRAPER_BOT_PASSWORD=change-me

# WhatsApp Cloud API (use mock_ prefixed tokens for local development)
ADMIN_PHONE=919000000000
META_VERIFY_TOKEN=mock_verify_token
WHATSAPP_PHONE_NUMBER_ID=mock_phone_number_id
WHATSAPP_ACCESS_TOKEN=mock_access_token
WHATSAPP_API_VERSION=v20.0
